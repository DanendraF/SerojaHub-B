# ─────────────────────────────────────────────────────────────────────────────
# SEROJA BACKEND — Environment Variables
# Copy file ini menjadi .env lalu isi nilainya
# ─────────────────────────────────────────────────────────────────────────────

# Prisma / Database (Supabase)
# Gunakan URL pooler (port 6543) untuk koneksi biasa + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Gunakan URL direct (port 5432) untuk migrate/push/generate
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Storage (untuk upload foto)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Server
PORT=5000
NODE_ENV=production

# CORS — URL frontend yang diizinkan
FRONTEND_URL="https://your-app.vercel.app"

# Keep-Alive — URL backend itu sendiri (untuk self-ping di production)
# Isi dengan URL backend yang sudah di-deploy, contoh: https://seroja-api.onrender.com
SELF_URL="https://seroja-api.onrender.com"
